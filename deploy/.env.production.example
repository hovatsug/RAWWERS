# RAWWERS production secrets and settings - the TEMPLATE.
#
# The real file lives ONLY on the server: /opt/rawwers/.env.production,
# readable by root only (chmod 600). Never in the repository, never in chat,
# never on the Mac. Make it with:
#
#   sudo deploy/scripts/generate-secrets.sh
#
# which copies this file and fills every <GENERATED_...> value with a fresh
# random one. Then fill every <FROM ...> value by hand (sudo nano), from the
# service named. The API refuses to start while any required value is empty,
# a placeholder or a development default, and names it
# (api/app/core/production_guard.py). docs/DEPLOY_SECRETS.md says how each
# one is made and rotated.
#
# Legend:  [generated]  made on the server by generate-secrets.sh
#          [service]    copied from a service's dashboard
#          [setting]    a plain choice, not secret

# ---- Images (docs/DEPLOY_RUNBOOK.md, "Images") ------------------------------
# [setting] what build-and-push.sh printed
API_IMAGE=<FROM build-and-push.sh: ghcr.io/<GITHUB_USER>/rawwers-api>
WEB_IMAGE=<FROM build-and-push.sh: ghcr.io/<GITHUB_USER>/rawwers-web>
IMAGE_TAG=<FROM build-and-push.sh: the 12-character commit>

# ---- Size of the stack (2 GB server; runbook "Resource budget") -------------
# [setting] raise together with the server size
API_WORKERS=1
WORKER_CONCURRENCY=2
PHOTO_WORKER_CONCURRENCY=1

# ---- The database ----------------------------------------------------------
# [setting] names; [generated] the password. The API's DATABASE_URL is built
# from these three by the compose file.
POSTGRES_DB=rawwers
POSTGRES_USER=rawwers
POSTGRES_PASSWORD=<GENERATED_HEX_24>

# ---- What this deployment is ------------------------------------------------
# [setting] test = Stripe test keys only, email only to EMAIL_DEV_ALLOWLIST.
# "live" is for the launch, written on purpose; never before.
DEPLOYMENT_MODE=test
LOG_LEVEL=INFO

# ---- Public addresses -------------------------------------------------------
# [setting] the web admin also serves the login, reset-password and
# unsubscribe pages, so app links point at it for now.
APP_PUBLIC_URL=https://admin.rawwers.com
API_PUBLIC_URL=https://api.rawwers.com
CORS_ALLOW_ORIGINS=https://admin.rawwers.com
CONNECT_RETURN_URL=https://api.rawwers.com/v1/payouts/connect/return
CONNECT_REFRESH_URL=https://api.rawwers.com/v1/payouts/connect/refresh

# ---- Behind Cloudflare ------------------------------------------------------
# [setting] believe CF-Connecting-IP only from Cloudflare's ranges
# (api/app/core/cloudflare_ips.txt). TRUSTED_PROXY_IPS is set by the compose file.
TRUST_CLOUDFLARE=true

# ---- Secrets made on the server ---------------------------------------------
# [generated] each a different random value. Changing one later has a cost:
# docs/DEPLOY_SECRETS.md, "Rotating".
AUTH_JWT_SECRET=<GENERATED_HEX_32>
MEDIA_SHARE_TOKEN_PEPPER=<GENERATED_HEX_32>
MEDIA_ACCESS_IP_HASH_PEPPER=<GENERATED_HEX_32>
SHARE_VIEW_FINGERPRINT_PEPPER=<GENERATED_HEX_32>
RISK_IP_HASH_PEPPER=<GENERATED_HEX_32>
RISK_DEVICE_HASH_PEPPER=<GENERATED_HEX_32>
RISK_SESSION_HASH_PEPPER=<GENERATED_HEX_32>
# One key: the API checks it, the web admin sends it (the compose file passes
# it to the web as ADMIN_API_KEY).
ADMIN_API_KEYS=<GENERATED_HEX_32>
ADDRESS_ENCRYPTION_KEYS=<GENERATED_FERNET_KEY>
UNSUBSCRIBE_SIGNING_KEYS=k1:<GENERATED_HEX_32>
# The token Brevo's webhook sends (runbook "Brevo"); [generated].
BREVO_WEBHOOK_TOKEN=<GENERATED_HEX_32>

# ---- Admin ------------------------------------------------------------------
# [setting] filled after the first account exists (runbook "The first admin").
ADMIN_USER_IDS=
# [setting] optional: only these addresses may use the admin API. Empty = any
# (Cloudflare Access protects admin.rawwers.com instead; runbook "Admin protection").
ADMIN_IP_ALLOWLIST=

# ---- Stripe (TEST mode) -----------------------------------------------------
# [service] Stripe dashboard, TEST mode: Developers > API keys > Secret key (sk_test_...)
STRIPE_SECRET_KEY=<FROM Stripe test mode: sk_test_...>
# [service] Developers > Webhooks > the https://api.rawwers.com/v1/webhooks/stripe endpoint > Signing secret
STRIPE_WEBHOOK_SECRET=<FROM Stripe test mode: whsec_...>

# ---- Cloudflare R2 (photos and files) ---------------------------------------
# [service] Cloudflare dashboard > R2 > the bucket, and R2 > Manage API tokens
R2_ENDPOINT_URL=<FROM Cloudflare R2: https://<ACCOUNT_ID>.r2.cloudflarestorage.com>
R2_ACCESS_KEY_ID=<FROM Cloudflare R2 API token: Access Key ID>
R2_SECRET_ACCESS_KEY=<FROM Cloudflare R2 API token: Secret Access Key>
R2_BUCKET=<FROM Cloudflare R2: the bucket name for this deployment>
R2_REGION=auto

# ---- Email (Brevo) ----------------------------------------------------------
EMAIL_SENDING_ENABLED=true
# [service] Brevo > SMTP & API > API keys (one key for this server)
BREVO_API_KEY=<FROM Brevo: xkeysib-...>
# [setting] a sender address verified in Brevo
BREVO_SENDER_EMAIL=<FROM Brevo: a verified sender on rawwers.com>
BREVO_SENDER_NAME=RAWWERS
BREVO_REPLY_TO=support@rawwers.com
# [setting] TEST deployment: the ONLY addresses mail is delivered to,
# comma-separated (your own). Everyone else's mail is logged, not sent.
EMAIL_DEV_ALLOWLIST=<FROM you: your own addresses, comma-separated>

# ---- Mux (video) - empty until the production Mux environment exists --------
# With these empty the video answers "Video is not available right now".
# docs/DEPLOY_CHECKLIST.md section 4 fills them, after this deploy.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=
PRESENTATION_VIDEO_ENABLED=false
MUX_PLAYBACK_MAX_RESOLUTION=720p

# ---- Error reporting (Sentry, EU) - optional --------------------------------
# [service] Sentry > rawwers-api > Settings > Client Keys (DSN). Empty = off.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production-test
# [service] Sentry > rawwers-web DSN, for the web server (the browser's copy is
# built into the image: build-and-push.sh, WEB_SENTRY_DSN_PUBLIC).
WEB_SENTRY_DSN=

# ---- Off for the beta (DEPLOY_CHECKLIST flag table) --------------------------
LLM_PROVIDER=mock
OPENAI_API_KEY=
SEARCH_PROVIDER=none
SEARCH_ENABLED=false

# ---- Small choices ----------------------------------------------------------
# The warm-up at start reads this city's home screen (UK first).
WARMUP_HOME_COUNTRY=GB
WARMUP_HOME_CITY=London
