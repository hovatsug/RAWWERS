<?xml version="1.0" encoding="utf-8"?>
<!-- The ground the Flutter splash paints on. @color/launch_ground is defined
     per flavor (src/client, src/pro) because the two apps have opposite fixed
     themes: a shared white here is the white flash this replaces. Deliberately
     not ?android:colorBackground - that follows the OS dark-mode setting, which
     neither flavor does. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_ground" />
</layer-list>
