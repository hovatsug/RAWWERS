APP_ENV=development
LOG_LEVEL=INFO

DATABASE_URL=postgresql+psycopg2://postgres:postgres@postgres:5432/rawwers
PRIMARY_DATABASE_URL=
REPLICA_DATABASE_URL=
MAX_REPLICA_LAG_SECONDS=15
REDIS_URL=redis://redis:6379/0
PUBLIC_CACHE_ENABLED=true
DISCOVER_CACHE_TTL_SECONDS=60
PRO_PUBLIC_CACHE_TTL_SECONDS=60
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10

R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rawwers-media
R2_REGION=auto

MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_API_VERSION=2024-06-20
STRIPE_WEBHOOK_ALLOW_UNVERIFIED=false

PLATFORM_FEE_BPS=2000
APP_PUBLIC_URL=http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
ADMIN_USER_IDS=
BAN_ENFORCEMENT_MODE=strict
ALLOW_UNVERIFIED_PRO=false
REWARD_POINTS_PER_EUR=100
REWARD_MAX_DISCOUNT_PERCENT=20

SEARCH_PROVIDER=meili
SEARCH_ENABLED=true
SEARCH_INDEX_PREFIX=rawwers_dev
MEILI_URL=http://localhost:7700
MEILI_API_KEY=

AUTH_JWT_SECRET=dev-insecure-auth-secret
AUTH_ACCESS_TOKEN_TTL_MINUTES=15
AUTH_REFRESH_TOKEN_TTL_DAYS=30
AUTH_EMAIL_VERIFICATION_TTL_MINUTES=30
AUTH_PASSWORD_RESET_TTL_MINUTES=30
AUTH_DEV_BYPASS=false
