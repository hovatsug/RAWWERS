// Flavor overrides for the client app. Included by Debug-client.xcconfig,
// Release-client.xcconfig and Profile-client.xcconfig — never included directly
// by a build configuration.
PRODUCT_BUNDLE_IDENTIFIER = com.rawwers.client
PRODUCT_NAME = RAWWERS
FLUTTER_TARGET = lib/main_client.dart

// Native launch ground, matching this flavor's Flutter splash so the two
// read as one screen rather than a white flash followed by the app.
LAUNCH_STORYBOARD_NAME = LaunchScreenClient

// This flavor's icon set (generated by tools/brand). Set here rather than
// in the project, so each flavor's xcconfig decides it.
ASSETCATALOG_COMPILER_APPICON_NAME = AppIcon-client
