<?xml version="1.0" encoding="utf-8"?>
<!-- The launch screen before Flutter's first frame, on Android 11 and below:
     the logo (drawable-*/launch_logo.png, generated by tools/brand) centred
     on @color/launch_ground, which is RInk.i950 for both flavors - the splash
     is always dark, in light and dark mode alike. Deliberately not
     ?android:colorBackground, which follows the OS dark-mode setting.
     Android 12+ draws its own splash instead: see values-v31/styles.xml. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_ground" />
    <item>
        <bitmap android:gravity="center" android:src="@drawable/launch_logo" />
    </item>
</layer-list>
