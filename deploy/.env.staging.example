# Image/version metadata
IMAGE_TAG=latest
GITHUB_REPOSITORY=rawwers/rawwers

# Runtime
APP_ENV=staging
LOG_LEVEL=INFO
APP_PUBLIC_URL=https://app.rawwers.com

# Datastores
POSTGRES_DB=rawwers
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql+psycopg2://postgres:change-me@postgres:5432/rawwers
REDIS_URL=redis://redis:6379/0

# Search
SEARCH_PROVIDER=meili
SEARCH_ENABLED=true
SEARCH_INDEX_PREFIX=rawwers_staging
MEILI_URL=http://meilisearch:7700
MEILI_API_KEY=change-me
MEILI_MASTER_KEY=change-me

# Storage / media
R2_ENDPOINT_URL=https://<accountid>.r2.cloudflarestorage.com
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=rawwers-media-staging
R2_REGION=auto

# Auth & API
AUTH_JWT_SECRET=change-me
CORS_ALLOW_ORIGINS=https://app.rawwers.com
AUTH_DEV_BYPASS=false
ALLOW_UNVERIFIED_PRO=false

# Stripe (staging keys)
STRIPE_SECRET_KEY=sk_test_change_me
STRIPE_WEBHOOK_SECRET=whsec_change_me
STRIPE_API_VERSION=2025-12-15.clover

# Mux. The webhook secret is the one this environment's own Mux webhook
# shows (Settings > Webhooks), never the dev CLI's (docs/MUX_LOCAL_WEBHOOKS.md).
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_KEY_PRIVATE=

# Optional local object store in staging
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me

# Email through Brevo (docs/BREVO_SETUP.md). Off until EMAIL_SENDING_ENABLED=true;
# with it on, the API refuses to start without the key, the sender and
# UNSUBSCRIBE_SIGNING_KEYS. One Brevo API key per environment.
# Staging is not production: it delivers only to EMAIL_DEV_ALLOWLIST.
EMAIL_DEV_ALLOWLIST=
EMAIL_SENDING_ENABLED=false
BREVO_API_KEY=
BREVO_SENDER_EMAIL=hello@mail.rawwers.com
BREVO_SENDER_NAME=RAWWERS
BREVO_REPLY_TO=support@rawwers.com
BREVO_WEBHOOK_TOKEN=
UNSUBSCRIBE_SIGNING_KEYS=
API_PUBLIC_URL=https://api.rawwers.com
